{
  "expo": {
    "name": "Nox",
    "slug": "nox",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nox.pomodoro",
      "infoPlist": {
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D0D0D",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "package": "com.nox.pomodoro"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "themeColor": "#0D0D0D",
      "backgroundColor": "#0D0D0D",
      "name": "Nox",
      "shortName": "Nox",
      "description": "A minimalist Pomodoro timer with a cat companion"
    },
    "plugins": [
      [
        "expo-av",
        {
          "microphonePermission": false
        }
      ]
    ]
  }
}
